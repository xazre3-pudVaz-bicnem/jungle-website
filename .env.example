# =============================================================================
# JUNGLE TRANSPORT サイト 環境変数
# このファイルを .env.local にコピーして値を設定してください。
# Vercel へデプロイする場合は、プロジェクト設定の Environment Variables に登録します。
# すべて未設定でも npm run build は成功します。
# =============================================================================

# -----------------------------------------------------------------------------
# サイトURL
# canonical / OGP / サイトマップの絶対URLに使用されます。
# 未設定の場合は https://www.jungle-transport24.com が使われます。
# 別ドメインへ移行する場合のみ設定してください。
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://www.jungle-transport24.com

# -----------------------------------------------------------------------------
# Google Search Console の所有権確認
# 「HTMLタグ」方式で表示される content="..." の値だけを設定します。
# ドメインプロパティ（DNS認証）で登録する場合は不要です。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Google Analytics 4
# 測定ID（G-XXXXXXXXXX）。未設定の場合、計測タグは一切出力されません。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# -----------------------------------------------------------------------------
# フォームのメール送信（Resend）
# 応募フォーム（/entry）で使用します。
# 3つが揃っていないと、送信時に「設定が必要な環境変数」が画面に表示され、
# 送信は成功扱いになりません（架空の成功を表示しない設計です）。
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# 送信元。Resend で所有権を認証したドメインのアドレスを指定します。
# iCloud/Gmail などのフリーメールは送信元には指定できません。
# ドメイン認証前の動作確認だけなら onboarding@resend.dev が使えます。
CONTACT_FROM_EMAIL=noreply@jungle-transport24.com

# 受信先。フリーメールでも指定できます（サイト上には表示されません）。
CONTACT_TO_EMAIL=

# -----------------------------------------------------------------------------
# Google Indexing API（任意・スクリプト実行時のみ使用）
# 求人詳細URLの公開・更新・削除通知にのみ使用してください。
# 秘密鍵は絶対に Git にコミットしないでください。
# -----------------------------------------------------------------------------
# A) サービスアカウントJSONファイルへのパス
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# B) サービスアカウントJSONの中身をそのまま貼り付け（1行）
# GOOGLE_SERVICE_ACCOUNT_JSON=

# C) メールアドレスと秘密鍵を個別に指定（改行は \n でエスケープ）
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# URLを省略して実行する場合に、求人slugからURLを組み立てるために使用します
SITE_URL=https://www.jungle-transport24.com
