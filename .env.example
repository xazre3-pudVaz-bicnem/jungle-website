# =============================================================================
# JUNGLE TRANSPORT サイト 環境変数
# このファイルを .env.local にコピーして値を設定してください。
# Vercel へデプロイする場合は、プロジェクト設定の Environment Variables に登録します。
# すべて未設定でも npm run build は成功します。
# =============================================================================

# -----------------------------------------------------------------------------
# サイトURL（必須ではないが本番では設定推奨）
# canonical / OGP / サイトマップの絶対URLに使用されます。
# 未設定の場合は src/data/site.ts の既定値が使われます。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://jungle-transport.jp

# -----------------------------------------------------------------------------
# Google Search Console の所有権確認
# 「HTMLタグ」方式で表示される content="..." の値だけを設定します。
# 未設定の場合、verification メタタグは出力されません。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# 応募フォームのメール送信（Resend）
# 3つすべてが設定されていないと、フォーム送信時に
# 「設定が必要な環境変数」が画面に表示され、送信は成功扱いになりません。
# -----------------------------------------------------------------------------
# Resend の APIキー（https://resend.com/api-keys）
RESEND_API_KEY=
# 送信元。Resendで認証済みのドメインのアドレスを指定します
CONTACT_FROM_EMAIL=noreply@jungle-transport.jp
# 応募通知の受信先
CONTACT_TO_EMAIL=

# -----------------------------------------------------------------------------
# Google Indexing API（任意・スクリプト実行時のみ使用）
# 以下のいずれか1つの方法で認証情報を渡します。
# 秘密鍵は絶対に Git にコミットしないでください。
# -----------------------------------------------------------------------------
# A) サービスアカウントJSONファイルへのパス
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# B) サービスアカウントJSONの中身をそのまま貼り付け（1行）
# GOOGLE_SERVICE_ACCOUNT_JSON=

# C) メールアドレスと秘密鍵を個別に指定（改行は \n でエスケープ）
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# URLを省略して実行する場合に、求人slugからURLを組み立てるために使用します
SITE_URL=https://jungle-transport.jp
